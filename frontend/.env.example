# Use demo mode for a deterministic local walkthrough without the backend.
VITE_API_MODE=demo

# Set VITE_API_MODE=live to use the integrated host through the Vite proxy.
# For a separately deployed static frontend, set this to the API origin only.
# Example: VITE_API_BASE_URL=https://provexa-api.onrender.com
VITE_API_BASE_URL=
